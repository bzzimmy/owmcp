{
  "name": "owmcp",
  "version": "0.1.0",
  "description": "MCP server for the Opiumware Roblox executor",
  "private": true,
  "type": "module",
  "bin": {
    "owmcp": "./build/index.js"
  },
  "files": [
    "build",
    "lua"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "lint": "eslint . && tsc --noEmit && npm run lint:lua",
    "lint:lua": "sh scripts/lint-lua.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.24",
    "eslint": "^10.11.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.1"
  },
  "license": "MIT",
  "author": "Ben Zimmermann"
}
